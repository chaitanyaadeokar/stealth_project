# Required only for live/model-based claim assessment. Never commit real tokens.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SEC=30

# Optional: required for access-controlled diarization model downloads.
HF_TOKEN=
MODERNBERT_MODEL_NAME=MoritzLaurer/ModernBERT-base-zeroshot-v2.0
CLASSIFIER_DEVICE=cpu
CLASSIFIER_CPU_THREADS=2
# --model auto uses this multilingual CPU model; CUDA auto keeps large-v3-turbo.
WHISPER_CPU_MODEL=base

# Defaults are inside the repository. Relative paths resolve from the working directory.
CONVERSATION_DB=data/sessions.sqlite3
VAGUE_LOG_FILE=vague.log

# PostgreSQL connection string for SQLAlchemy's asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5432/postgres
LOG_LEVEL=INFO
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en
WHISPER_TASK=transcribe
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_FINAL_BEAM_SIZE=5
# Optional vocabulary, e.g. speaker names and place names, without full sentences.
WHISPER_INITIAL_PROMPT=
AUDIO_SAMPLE_RATE=16000
AUDIO_QUEUE_SIZE=400
STREAMING_WINDOW_SEC=1.2
STREAMING_UPDATE_SEC=0.4
SENTENCE_SILENCE_SEC=2.0
SPEECH_RMS_THRESHOLD=0.006
MAX_UTTERANCE_SEC=30
# Optional: enables Groq fact-check reasoning.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SEC=30
# Phase 1: defaults to GROQ_MODEL when unset. Classification uses Groq JSON output.
INTENT_MODEL=
CONTEXT_WINDOW_TURNS=20
CONTEXT_MAX_SESSIONS=100
ORCHESTRATION_QUEUE_SIZE=100
PERSISTENCE_QUEUE_SIZE=500
PERSISTENCE_RETRIES=3
PERSISTENCE_RETRY_SEC=0.25
PERSISTENCE_TIMEOUT_SEC=5
PERSISTENCE_SHUTDOWN_SEC=10
# Phase 2: Memcached is disposable; PostgreSQL remains the source of truth.
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
SESSION_TTL_SECONDS=3600
MEMORY_TIMEOUT_SEC=0.15
MEMORY_DB_TIMEOUT_SEC=0.5
MEMORY_MAX_BYTES=900000
MEMORY_CAS_RETRIES=8
MEMORY_QUEUE_SIZE=500
# Phase 3: preserve all claims; promote substantial high-confidence agent responses.
LTM_PROMOTE_ON_RESULT=true
LTM_MIN_CONFIDENCE=0.75
LTM_MIN_RESPONSE_CHARS=80
LTM_QUEUE_SIZE=500
LTM_JOB_TIMEOUT_SEC=30


